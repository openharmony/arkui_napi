import("//foundation/arkui/napi/napi.gni")

if (ark_standalone_build) {
  import("$build_root/ark.gni")
} else {
  import("//build/ohos.gni")
}

# Pollution-regression sample: exports an accessor property whose getter throws; pairs with
# the regular test module (see run_poison in ../BUILD.gn).
ohos_shared_library("poison") {
    sources = [ "poison.cpp" ]

    deps = [ "../../../..:ace_napi" ]

    subsystem_name = "arkui"
    part_name = "napi"
}
