import("//foundation/arkui/napi/napi.gni")

if (ark_standalone_build) {
  import("$build_root/ark.gni")
} else {
  import("//build/ohos.gni")
}

# Host-side illegal-API-exposure checker: loads native .so modules and compares their
# runtime exports against the legal API list.
ohos_executable("checkapi") {
  use_exceptions = true

  sources = [
    "check_api.cpp",
    "check_helper.cpp",
    "check_match.cpp",
    "load_abc.cpp",
    "load_so.cpp",
    "parse_json.cpp",
  ]

  include_dirs = [ "." ]

  # Link libace_napi.so so requireNapi/native_module_manager is shared with the checked .so;
  # public_configs propagates this repo's headers and platform macros.
  deps = [ "//foundation/arkui/napi:ace_napi" ]

  external_deps = [
    "cJSON:cjson",
    "ets_runtime:libark_jsruntime",
  ]

  # Device builds route utils/log.h to hilog; keep the platform guard in sync with ace_napi
  # in the main BUILD.gn.
  if (!is_mingw && !is_mac && !is_linux && is_ohos_standard_system) {
    external_deps += [ "hilog:libhilog" ]
  }

  subsystem_name = "arkui"
  part_name = "napi"
}

# Sample end-to-end tests (build on demand):
#   ninja -C out/<dir> checkapi_samples
group("checkapi_samples") {
  deps = [ "sample:run_test" ]
}
